        -96
      ],
      "id": "352ac5ac-4a16-4258-a8b8-7cf27aa53f71",
      "name": "Split PR diff"
    },
    {
      "parameters": {
        "jsCode": "const split = $('Split PR diff');\nconst hunks = split.all();\nconst output = $input.all();\nif (hunks.length === 0 || output.length !== hunks.length) {\n  throw new Error('Expected one review comment for each diff hunk');\n}\n\nconst seen = new Set();\nconst comments = output.map((item, index) => {\n  const { path, line, side } = split.itemMatching(index).json.anchor;\n  const body = item.json.output?.trim();\n  if (!body) {\n    throw new Error('The model returned an empty review for ' + path + ':' + line);\n  }\n\n  const key = JSON.stringify([path, line, side]);\n  if (seen.has(key)) {\n    throw new Error('Multiple review items point to the same diff line');\n  }\n  seen.add(key);\n  return { path, line, side, body };\n});\n\nconst event = $('PR Trigger1').first().json.body;\nconst repo = event.repository.full_name;\nconst number = event.pull_request?.number ?? event.issue?.number;\nconst model = event.comment?.body?.trim() === '/make_other_ai_review'\n  ? 'deepseek-v4-pro'\n  : 'deepseek-flash';\n\nreturn [{\n  json: {\n    reviewUrl: 'https://api.github.com/repos/' + repo + '/pulls/' + number + '/reviews',\n    review: {\n      event: 'COMMENT',\n      body: 'AI-ревью по блокам diff · ' + model + ' · комментариев: ' + comments.length,\n      comments,\n    },\n  },\n  pairedItem: { item: 0 },\n}];"
      },
