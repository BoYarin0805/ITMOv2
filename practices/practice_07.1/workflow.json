    {
      "parameters": {
        "jsCode": "const diff = $input.first().json.data;\nif (typeof diff !== 'string') {\n  throw new Error('Expected the GitHub diff as text in data');\n}\n\nfunction readPath(header) {\n  const path = header.slice(4).split('\\t', 1)[0];\n  if (path === '/dev/null') return null;\n  if (!path.startsWith('\"')) return path.slice(2);\n\n  const escapes = {\n    a: '\\x07', b: '\\b', t: '\\t', n: '\\n', v: '\\v', f: '\\f', r: '\\r',\n    '\"': '\"', '\\\\': '\\\\',\n  };\n  const encodedPath = path.slice(1, -1).replace(/%/g, '%25')\n    .replace(/\\\\([0-7]{3}|.)/g, (_, code) => {\n      if (code.length === 3) {\n        return '%' + parseInt(code, 8).toString(16).padStart(2, '0');\n      }\n      return encodeURIComponent(escapes[code] ?? code);\n    });\n  return decodeURIComponent(encodedPath).slice(2);\n}\n\nconst items = [];\nlet oldPath = null;\nlet newPath = null;\nlet hunk = null;\n\nfunction finishHunk() {\n  if (!hunk) return;\n  const path = newPath ?? oldPath;\n  const location = hunk.firstAddition ?? hunk.firstDeletion;\n  if (path && location) {\n    items.push({\n      json: {\n        anchor: { path, ...location },\n        data: ['File: ' + path, ...hunk.lines].join('\\n'),\n      },\n      pairedItem: { item: 0 },\n    });\n  }\n  hunk = null;\n}\n\nfor (const line of diff.split(/\\r?\\n/)) {\n  if (line.startsWith('diff --git ')) {\n    finishHunk();\n    oldPath = null;\n    newPath = null;\n    continue;\n  }\n\n  const header = /^@@ -(\\d+)(?:,\\d+)? \\+(\\d+)(?:,\\d+)? @@/.exec(line);\n  if (header) {\n    finishHunk();\n    hunk = { oldLine: Number(header[1]), newLine: Number(header[2]), lines: [line] };\n    continue;\n  }\n\n  if (!hunk) {\n    if (line.startsWith('--- ')) oldPath = readPath(line);\n    if (line.startsWith('+++ ')) newPath = readPath(line);\n    continue;\n  }\n\n  hunk.lines.push(line);\n  if (line.startsWith('+')) {\n    hunk.firstAddition ??= { line: hunk.newLine, side: 'RIGHT' };\n    hunk.newLine += 1;\n  } else if (line.startsWith('-')) {\n    hunk.firstDeletion ??= { line: hunk.oldLine, side: 'LEFT' };\n    hunk.oldLine += 1;\n  } else if (line.startsWith(' ')) {\n    hunk.oldLine += 1;\n    hunk.newLine += 1;\n  }\n}\nfinishHunk();\n\nreturn items;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
