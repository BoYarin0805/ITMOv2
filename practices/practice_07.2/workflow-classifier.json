          "name": "OpenAI account 61"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\": \"object\", \"properties\": {\"type\": {\"type\": \"string\", \"enum\": [\"bug\", \"task\", \"feature\", \"unknown\"]}, \"confidence\": {\"type\": \"number\", \"minimum\": 0, \"maximum\": 1}}, \"required\": [\"type\", \"confidence\"], \"additionalProperties\": false}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        464,
        224
      ],
      "id": "51fcc4d4-77ac-4e4a-a6d6-804975914bba",
      "name": "Type and confidence schema"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((item, index) => {\n  let parsed = item.json.output ?? item.json.text ?? item.json;\n  if (typeof parsed === 'string') {\n    try {\n      parsed = JSON.parse(parsed);\n    } catch {\n      parsed = null;\n    }\n  }\n\n  const type = parsed?.type;\n  const confidence = parsed?.confidence;\n  const validType = ['bug', 'task', 'feature', 'unknown'].includes(type);\n  const validScore = Number.isFinite(confidence) && confidence >= 0 && confidence <= 1;\n  const classification = validType && validScore\n    ? { type, confidence }\n    : { type: 'unknown', confidence: 0 };\n\n  return { json: classification, pairedItem: { item: index } };\n});"
      },
      "type": "n8n-nodes-base.code",
