{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/mimo-v2.6-flash-free",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Ollama",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "timeout": 300000
      },
      "models": {
        "notify-agent": {
          "name": "Notify Mini local Qwen3 4B",
          "limit": {
            "context": 8192,
            "output": 512
          }
        }
      }
    }
  },
  "mcp": {
    "notify_checks": {
      "type": "local",
      "command": [
        "python3",
        "mcp/server.py"
      ],
      "enabled": true
    }
  },
  "default_agent": "practice-builder",
  "agent": {
    "practice-builder": {
      "description": "Помощник по двум фичам Notify Mini и проверке среды",
      "mode": "primary",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "allow",
        "bash": "allow",
        "skill": "allow",
        "notify_checks_*": "allow"
      }
    }
  }
}
