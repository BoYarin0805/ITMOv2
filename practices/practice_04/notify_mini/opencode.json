{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/notify-agent",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Ollama",
      "options": {"baseURL": "http://127.0.0.1:11434/v1", "timeout": 300000},
      "models": {
        "notify-agent": {
          "name": "Notify Mini local Qwen3 4B",
          "limit": {"context": 8192, "output": 512}
        }
      }
    }
  },
  "mcp": {
    "notify_checks": {
      "type": "local",
      "command": ["python3", "mcp/server.py"],
      "enabled": true
    }
  }
}
